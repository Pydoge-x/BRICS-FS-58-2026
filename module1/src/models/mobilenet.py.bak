"""
MobileNet模型 - 表情识别
基于MobileNetV2/V3的轻量化模型
"""

import torch
import torch.nn as nn
import torchvision.models as models
from typing import Optional


class FER_MobileNet(nn.Module):
    """
    人脸表情识别模型 - 基于MobileNet
    
    支持MobileNetV2, MobileNetV3-Small, MobileNetV3-Large
    """
    
    def __init__(
        self, 
        num_classes: int = 7, 
        mobilenet_type: str = 'mobilenetv3_small',
        pretrained: bool = True, 
        dropout_rate: float = 0.2
    ):
        """
        初始化MobileNet模型
        
        Args:
            num_classes: 分类类别数
            mobilenet_type: MobileNet类型
            pretrained: 是否使用预训练权重
            dropout_rate: Dropout比例
        """
        super(FER_MobileNet, self).__init__()
        
        self.mobilenet_type = mobilenet_type
        self.num_classes = num_classes
        
        # 加载预训练模型
        if mobilenet_type == 'mobilenetv2':
            if pretrained:
                self.model = models.mobilenet_v2(weights=models.MobileNet_V2_Weights.IMAGENET1K_V1)
            else:
                self.model = models.mobilenet_v2(weights=None)
            
            # 修改分类器
            in_features = self.model.classifier[1].in_features
            self.model.classifier = nn.Sequential(
                nn.Dropout(p=dropout_rate),
                nn.Linear(in_features, num_classes)
            )
            
        elif mobilenet_type == 'mobilenetv3_small':
            if pretrained:
                self.model = models.mobilenet_v3_small(weights=models.MobileNet_V3_Small_Weights.IMAGENET1K_V1)
            else:
                self.model = models.mobilenet_v3_small(weights=None)
            
            # 修改分类器
            # MobileNetV3-Small原始分类器结构不同
            in_features = self.model.classifier[0].in_features
            self.model.classifier = nn.Sequential(
                nn.Linear(in_features, 576),
                nn.Hardswish(inplace=True),
                nn.Dropout(p=dropout_rate, inplace=True),
                nn.Linear(576, num_classes)
            )
            
        elif mobilenet_type == 'mobilenetv3_large':
            if pretrained:
                self.model = models.mobilenet_v3_large(weights=models.MobileNet_V3_Large_Weights.IMAGENET1K_V1)
            else:
                self.model = models.mobilenet_v3_large(weights=None)
            
            # 修改分类器
            in_features = self.model.classifier[0].in_features
            self.model.classifier = nn.Sequential(
                nn.Linear(in_features, 960),
                nn.Hardswish(inplace=True),
                nn.Dropout(p=dropout_rate, inplace=True),
                nn.Linear(960, num_classes)
            )
            
        else:
            raise ValueError(f"不支持的MobileNet类型: {mobilenet_type}")
    
    def forward(self, x: torch.Tensor) -> torch.Tensor:
        """前向传播"""
        return self.model(x)
    
    def get_features(self, x: torch.Tensor) -> torch.Tensor:
        """提取特征"""
        x = self.model.features(x)
        x = self.model.avgpool(x)
        x = torch.flatten(x, 1)
        return x


def create_mobilenet_model(
    mobilenet_type: str = 'mobilenetv3_small',
    num_classes: int = 7,
    pretrained: bool = True,
    dropout_rate: float = 0.2
) -> FER_MobileNet:
    """
    创建MobileNet表情识别模型
    
    Args:
        mobilenet_type: MobileNet类型
        num_classes: 分类类别数
        pretrained: 是否使用预训练权重
        dropout_rate: Dropout比例
    
    Returns:
        FER_MobileNet模型
    """
    return FER_MobileNet(
        num_classes=num_classes,
        mobilenet_type=mobilenet_type,
        pretrained=pretrained,
        dropout_rate=dropout_rate
    )


