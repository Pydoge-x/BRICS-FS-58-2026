"""
MobileViT模型 - 表情识别
CNN + Transformer融合的轻量化模型
"""

import torch
import torch.nn as nn
import timm
from typing import Optional, Dict


class FER_MobileViT(nn.Module):
    """
    人脸表情识别模型 - 基于MobileViT
    
    使用timm库加载MobileViT预训练模型
    """
    
    def __init__(
        self, 
        num_classes: int = 7, 
        model_name: str = 'mobilevit_xs',
        pretrained: bool = True, 
        dropout_rate: float = 0.1
    ):
        """
        初始化MobileViT模型
        
        Args:
            num_classes: 分类类别数
            model_name: MobileViT模型名称
            pretrained: 是否使用预训练权重
            dropout_rate: Dropout比例
        """
        super(FER_MobileViT, self).__init__()
        
        self.model_name = model_name
        self.num_classes = num_classes
        
        # 使用timm创建模型
        self.model = timm.create_model(
            model_name,
            pretrained=pretrained,
            num_classes=num_classes,
            drop_rate=dropout_rate
        )
    
    def forward(self, x: torch.Tensor) -> torch.Tensor:
        """前向传播"""
        return self.model(x)
    
    def get_features(self, x: torch.Tensor) -> torch.Tensor:
        """提取特征"""
        return self.model.forward_features(x)


def create_mobilevit_model(
    model_name: str = 'mobilevit_xs',
    num_classes: int = 7,
    pretrained: bool = True,
    dropout_rate: float = 0.1
) -> FER_MobileViT:
    """
    创建MobileViT表情识别模型
    
    Args:
        model_name: MobileViT模型名称
        num_classes: 分类类别数
        pretrained: 是否使用预训练权重
        dropout_rate: Dropout比例
    
    Returns:
        FER_MobileViT模型
    """
    return FER_MobileViT(
        num_classes=num_classes,
        model_name=model_name,
        pretrained=pretrained,
        dropout_rate=dropout_rate
    )


