# 自定义MobileViT Block实现（可选）
class MobileViTBlock(nn.Module):
    """
    MobileViT核心模块
    局部卷积 + 全局Transformer
    """
    
    def __init__(
        self, 
        in_channels: int, 
        out_channels: int,
        patch_size: int = 2,
        transformer_dim: int = 64,
        num_heads: int = 4,
        num_layers: int = 2,
        dropout: float = 0.1
    ):
        super(MobileViTBlock, self).__init__()
        
        # 局部表示层
        self.local_rep = nn.Sequential(
            nn.Conv2d(in_channels, in_channels, kernel_size=3, padding=1, groups=in_channels),
            nn.BatchNorm2d(in_channels),
            nn.SiLU(inplace=True),
            nn.Conv2d(in_channels, transformer_dim, kernel_size=1),
        )
        
        # Transformer编码器
        encoder_layer = nn.TransformerEncoderLayer(
            d_model=transformer_dim,
            nhead=num_heads,
            dim_feedforward=int(transformer_dim * 4),
            dropout=dropout,
            activation='gelu',
            batch_first=True,
            norm_first=True
        )
        self.transformer = nn.TransformerEncoder(encoder_layer, num_layers=num_layers)
        
        # 融合层
        self.fusion = nn.Sequential(
            nn.Conv2d(transformer_dim, out_channels, kernel_size=1),
            nn.BatchNorm2d(out_channels),
        )
    
    def forward(self, x: torch.Tensor) -> torch.Tensor:
        # 局部特征
        local_features = self.local_rep(x)
        
        # 展平为序列
        B, D, H, W = local_features.shape
        patches = local_features.flatten(2).transpose(1, 2)  # [B, H*W, D]
        
        # Transformer处理
        transformer_out = self.transformer(patches)
        
        # 恢复形状
        transformer_out = transformer_out.transpose(1, 2).reshape(B, D, H, W)
        
        # 融合
        output = self.fusion(transformer_out)
        
        return output